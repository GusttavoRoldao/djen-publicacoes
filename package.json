{
  "name": "djen-publicacoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "check": "tsc --noEmit",
    "check:native": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "node --test --test-isolation=none tests/**/*.test.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "validate:djen": "node src/cli.ts",
    "package:installer": "node scripts/package-installer.mjs",
    "release": "npm run build:desktop && npm run package:installer"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "write-excel-file": "^4.1.1"
  },
  "license": "MIT",
  "description": "Aplicativo desktop para pesquisar e organizar localmente publicações do DJEN."
}
